@{
    ViewData["Title"] = "Bản đồ An ninh Đà Nẵng - Quảng Nam";
    var maptileKey = ViewData["GoongMaptileKey"]?.ToString();
    var restApiKey = ViewData["GoongRestApiKey"]?.ToString();
}

<link href="https://cdn.jsdelivr.net/npm/@@goongmaps/goong-js@1.0.9/dist/goong-js.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />

<!-- Container full-screen -->
<div class="gm-container">

    <!-- ════ SIDEBAR NAVIGATION ════ -->
    <div class="gm-sidebar" id="gmSidebar">
        <button class="gm-sidebar-btn active" id="btnNavMap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
                <line x1="9" y1="3" x2="9" y2="18"></line>
                <line x1="15" y1="6" x2="15" y2="21"></line>
            </svg>
            <span class="gm-sidebar-text">Bản đồ</span>
        </button>
        <button class="gm-sidebar-btn" id="btnNavReports" onclick="window.location.href='/User/Dashboard'">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span class="gm-sidebar-text">Báo cáo<br>của tôi</span>
        </button>
        <button class="gm-sidebar-btn" id="btnOpenReport">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span class="gm-sidebar-text">Báo cáo<br>sự cố</span>
        </button>
        <button class="gm-sidebar-btn" id="btnToggleHiddenAlerts" style="display:none" title="Hiện/ẩn các tin đã bị ẩn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
            <span class="gm-sidebar-text">Tin ẩn</span>
        </button>
        <button class="gm-sidebar-btn" id="btnToggleProximityAlerts" title="Bật hoặc tắt cảnh báo vị trí">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <path d="M12 2l9 16H3L12 2z"></path>
                <path d="M12 9v4"></path>
                <path d="M12 17h.01"></path>
            </svg>
            <span class="gm-sidebar-text">Bật cảnh báo<br>vị trí</span>
        </button>
        <button class="gm-sidebar-btn" id="btnNearbyPanel" title="Tìm dịch vụ gần bạn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 2v3"></path>
                <path d="M12 19v3"></path>
                <path d="M2 12h3"></path>
                <path d="M19 12h3"></path>
                <path d="M18.4 5.6l-2.1 2.1"></path>
                <path d="M7.7 16.3l-2.1 2.1"></path>
            </svg>
            <span class="gm-sidebar-text">Gần tôi</span>
        </button>
        <button class="gm-sidebar-btn" id="btnFilterPanel" title="Bộ lọc sự cố">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <path d="M3 5h18"></path>
                <path d="M6 12h12"></path>
                <path d="M10 19h4"></path>
            </svg>
            <span class="gm-sidebar-text">Bộ lọc</span>
            <span class="gm-sidebar-badge" id="gmFilterBadge" style="display:none">0</span>
        </button>
        <button class="gm-sidebar-btn" id="btnLayerPanel" title="Lớp bản đồ">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <path d="M12 2 2 7l10 5 10-5-10-5z"></path>
                <path d="m2 12 10 5 10-5"></path>
                <path d="m2 17 10 5 10-5"></path>
            </svg>
            <span class="gm-sidebar-text">Lớp</span>
        </button>
        <button class="gm-sidebar-btn" id="btnSafeRoutePanel" title="Tuyến đường an toàn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <path d="M12 22s7-4 7-10V5l-7-3-7 3v7c0 6 7 10 7 10z"></path>
                <path d="m9 12 2 2 4-5"></path>
            </svg>
            <span class="gm-sidebar-text">Tuyến<br>an toàn</span>
        </button>
    </div>

    <!-- ════ FLOATING PANEL (Google Maps style) ════ -->
    <div class="gm-panel" id="gmPanel">

        <!-- ── STATE 1: Thanh tìm kiếm ── -->
        <div class="gm-search-wrap" id="stateSearch">
            <div class="gm-searchbar">
                <svg class="gm-search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="17" height="17">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" id="mapSearchInput"
                       placeholder="Tìm địa điểm tại Đà Nẵng, Quảng Nam..."
                       autocomplete="off"/>
                <button id="btnClearSearch" style="display:none">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <!-- Dropdown kết quả tìm kiếm -->
            <div class="gm-dropdown" id="searchDropdown" style="display:none"></div>
        </div>

        <!-- ── STATE 2: Card thông tin địa điểm ── -->
        <div class="gm-place-card" id="gmPlaceCard" style="display:none">
            <div class="gm-place-card__photo">
                <div class="gm-photo-skeleton" id="gmPhotoSkeleton"></div>
                <img id="cardPlaceImg" src="" alt="Place Photo" style="display:none" 
                     onload="this.style.display='block'; document.getElementById('gmPhotoSkeleton').style.display='none'; this.classList.add('loaded');" 
                     onerror="this.src='/images/default-place.jpg'" />
            </div>
            <div class="gm-place-card__header">
                <button class="gm-back-btn" id="btnClosePlaceCard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </button>
                <div>
                    <div class="gm-place-name" id="cardPlaceName">—</div>
                    <div class="gm-place-addr" id="cardPlaceAddr"></div>
                </div>
            </div>
            <div class="gm-place-coords" id="cardPlaceCoords"></div>
            <div class="gm-place-actions">
                <button class="gm-action-btn gm-action-btn--primary" id="btnGetDirections">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
                        <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                    </svg>
                    Đường đi
                </button>
                <button class="gm-action-btn gm-action-btn--outline" id="btnUseMyLoc">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
                        <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/>
                    </svg>
                    Định vị
                </button>
            </div>
        </div>

        <!-- ── STATE 3: Panel chỉ đường ── -->
        <div class="gm-route-card" id="gmRouteCard" style="display:none">

            <div class="gm-route-card__header">
                <button class="gm-back-btn" id="btnCloseRoute">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </button>
                <span>Chỉ đường</span>
                <button class="gm-swap-btn" id="btnSwapRoute" title="Đổi chiều">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                        <polyline points="17 1 21 5 17 9"/>
                        <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                        <polyline points="7 23 3 19 7 15"/>
                        <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                    </svg>
                </button>
            </div>

            <div class="gm-route-inputs">
                <!-- Điểm đi -->
                <div class="gm-route-field">
                    <div class="gm-route-dot gm-route-dot--from"></div>
                    <div class="gm-route-input-wrap">
                        <input type="text" id="routeStart" class="gm-route-input"
                               placeholder="Điểm xuất phát..." autocomplete="off"/>
                        <button class="gm-myloc-btn" id="btnMyLocForRoute" title="Vị trí của tôi">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13">
                                <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/>
                            </svg>
                        </button>
                        <div class="gm-suggestions" id="suggStart"></div>
                    </div>
                </div>
                <div class="gm-route-connector"></div>
                <!-- Điểm đến -->
                <div class="gm-route-field">
                    <div class="gm-route-dot gm-route-dot--to"></div>
                    <div class="gm-route-input-wrap">
                        <input type="text" id="routeEnd" class="gm-route-input"
                               placeholder="Điểm đến..." autocomplete="off"/>
                        <div class="gm-suggestions" id="suggEnd"></div>
                    </div>
                </div>
            </div>

            <!-- Nút tìm đường -->
            <div class="gm-route-actions">
                <label class="gm-safe-route-toggle">
                    <input type="checkbox" id="safeRouteToggle" />
                    <span class="gm-toggle-ui"></span>
                    <span>
                        <strong>Tránh điểm nóng</strong>
                        <small>Cảnh báo nếu tuyến đi gần sự cố</small>
                    </span>
                </label>
                <button class="gm-find-btn" id="btnFindRoute">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
                        <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                    </svg>
                    Tìm đường
                </button>
            </div>

            <!-- Trạng thái -->
            <div class="gm-route-status" id="routeStatus" style="display:none"></div>
            <div class="gm-safe-route-status" id="safeRouteStatus" style="display:none"></div>

            <!-- Kết quả 3 phương tiện -->
            <div class="gm-route-results" id="routeResults" style="display:none">
                <div class="gm-result-row active" id="resDriving">
                    <span class="gm-result-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"></path></svg>
                    </span>
                    <div class="gm-result-body">
                        <div class="gm-result-time" id="timeCar">—</div>
                        <div class="gm-result-dist" id="distCar">—</div>
                    </div>
                    <div class="gm-result-badge">Nhanh</div>
                </div>
                <div class="gm-result-row" id="resMoto">
                    <span class="gm-result-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M19.44 9.03L15.41 5H11v2h3.59l2 2H5c-2.8 0-5 2.2-5 5s2.2 5 5 5c2.46 0 4.45-1.69 4.9-4h4.2c.45 2.31 2.44 4 4.9 4 2.8 0 5-2.2 5-5 0-2.12-1.39-3.96-3.36-4.73zM5 17c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm14 0c-1.66 0-3-1.34-3-3 0-.09.01-.18.02-.27l3.66-3.66c1.23.41 2.15 1.51 2.29 2.89L19 14v3zM10.84 13L9.61 11h6.63l-1.92 1.92-3.48.08z"></path></svg>
                    </span>
                    <div class="gm-result-body">
                        <div class="gm-result-time" id="timeMoto">—</div>
                        <div class="gm-result-dist" id="distMoto">—</div>
                    </div>
                </div>
                <div class="gm-result-row" id="resFoot">
                    <span class="gm-result-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M13.5 5.5c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zM9.8 8.9L7 23h2.1l1.8-8 2.1 2v6h2v-7.5l-2.1-2 .6-3C14.8 12 16.8 13 19 13v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1L6 8.3V13h2V9.6l1.8-.7"></path></svg>
                    </span>
                    <div class="gm-result-body">
                        <div class="gm-result-time" id="timeFoot">—</div>
                        <div class="gm-result-dist" id="distFoot">—</div>
                    </div>
                </div>
                <button class="gm-clear-btn" id="btnClearRoute">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    Xóa tuyến đường
                </button>
            </div>

        </div><!-- /gm-route-card -->

        <div class="gm-nearby-panel" id="gmNearbyPanel" style="display:none">
            <div class="gm-nearby-header">
                <div>
                    <div class="gm-nearby-title">Cần hỗ trợ gần bạn?</div>
                    <div class="gm-nearby-subtitle">Chọn một nhu cầu để tìm trong bản đồ</div>
                </div>
                <button class="gm-nearby-close" id="btnNearbyClose" title="Đóng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="gm-nearby-picker" id="gmNearbyPicker">
                <button class="gm-nearby-option" data-nearby-type="motorcycle_repair" data-nearby-label="Hư xe / tắt xe">
                    <span class="gm-nearby-option__icon">W</span>
                    <span>Hư xe / tắt xe</span>
                </button>
                <button class="gm-nearby-option" data-nearby-type="fuel" data-nearby-label="Hết xăng">
                    <span class="gm-nearby-option__icon">Xăng</span>
                    <span>Hết xăng</span>
                </button>
                <button class="gm-nearby-option" data-nearby-type="hospital" data-nearby-label="Cần bệnh viện">
                    <span class="gm-nearby-option__icon">BV</span>
                    <span>Cần bệnh viện</span>
                </button>
                <button class="gm-nearby-option" data-nearby-type="pharmacy" data-nearby-label="Cần nhà thuốc">
                    <span class="gm-nearby-option__icon">Thuốc</span>
                    <span>Cần nhà thuốc</span>
                </button>
                <button class="gm-nearby-option" data-nearby-type="atm" data-nearby-label="Cần ATM">
                    <span class="gm-nearby-option__icon">ATM</span>
                    <span>Cần ATM</span>
                </button>
                <button class="gm-nearby-option" data-nearby-type="police" data-nearby-label="Cần công an">
                    <span class="gm-nearby-option__icon">CA</span>
                    <span>Cần công an</span>
                </button>
                <button class="gm-nearby-option" data-nearby-type="fire_station" data-nearby-label="Cần cứu hỏa">
                    <span class="gm-nearby-option__icon">114</span>
                    <span>Cần cứu hỏa</span>
                </button>
                <button class="gm-nearby-option gm-nearby-option--urgent" data-nearby-type="emergency" data-nearby-label="Gọi khẩn cấp">
                    <span class="gm-nearby-option__icon">SOS</span>
                    <span>Gọi khẩn cấp</span>
                </button>
            </div>
            <div class="gm-nearby-status" id="gmNearbyStatus" style="display:none"></div>
            <div class="gm-nearby-results" id="gmNearbyResults" style="display:none"></div>
        </div>

        <div class="gm-maptool-panel" id="gmFilterPanel" style="display:none">
            <div class="gm-maptool-header">
                <div>
                    <div class="gm-maptool-title">Bộ lọc sự cố</div>
                    <div class="gm-maptool-subtitle">Lọc theo loại và trạng thái báo cáo</div>
                </div>
                <button class="gm-maptool-close" id="btnFilterClose" title="Đóng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="gm-maptool-body">
                <div class="gm-maptool-section">
                    <div class="gm-maptool-label">Loại sự cố</div>
                    <div class="gm-filter-chips" id="gmFilterTypes"></div>
                </div>
                <div class="gm-maptool-section">
                    <div class="gm-maptool-label">Trạng thái</div>
                    <div class="gm-filter-chips" id="gmFilterStatuses">
                        <button type="button" class="gm-chip" data-filter-status="VISIBLE_VERIFIED">Đã xác thực</button>
                        <button type="button" class="gm-chip" data-filter-status="VISIBLE_UNVERIFIED">Chưa xác thực</button>
                        <button type="button" class="gm-chip" data-filter-status="NEEDS_MORE_INFO,NOT_ENOUGH_EVIDENCE">Cần bổ sung</button>
                        <button type="button" class="gm-chip" data-filter-status="RESOLVED">Đã xử lý</button>
                        <button type="button" class="gm-chip" data-filter-status="REJECTED,EXPIRED">Đã ẩn</button>
                    </div>
                </div>
                <button type="button" class="gm-maptool-reset" id="btnClearMapFilters">Xóa lọc</button>
            </div>
        </div>

        <div class="gm-maptool-panel" id="gmLayerPanel" style="display:none">
            <div class="gm-maptool-header">
                <div>
                    <div class="gm-maptool-title">Lớp bản đồ</div>
                    <div class="gm-maptool-subtitle">Tùy chỉnh lớp hiển thị trên bản đồ</div>
                </div>
                <button class="gm-maptool-close" id="btnLayerClose" title="Đóng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="gm-maptool-body">
                <div class="gm-maptool-section">
                    <div class="gm-maptool-label">Nền bản đồ</div>
                    <div class="gm-segmented">
                        <button type="button" class="active" id="btnBaseMap">Bản đồ</button>
                        <button type="button" id="btnSatelliteMap">Vệ tinh</button>
                    </div>
                </div>
                <label class="gm-layer-row">
                    <span>Báo cáo sự cố</span>
                    <input type="checkbox" id="layerAlertsToggle" checked />
                </label>
                <label class="gm-layer-row">
                    <span>Vùng nhiệt</span>
                    <input type="checkbox" id="layerHeatmapToggle" checked />
                </label>
                <label class="gm-layer-row">
                    <span>Ranh giới khu vực</span>
                    <input type="checkbox" id="layerBoundaryToggle" checked />
                </label>
            </div>
        </div>

    </div><!-- /gm-panel -->

    <!-- ════ BẢN ĐỒ ════ -->
    <div id="map"></div>
    <button class="gm-refresh-location" id="btnRefreshNearbyLocation" style="display:none" title="Làm mới vị trí">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="16" height="16">
            <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
            <path d="M21 3v6h-6"></path>
        </svg>
        Làm mới vị trí
    </button>
    <div class="gm-nearby-loading" id="gmNearbyLoading" style="display:none">
        <div class="gm-nearby-loading__box">
            <div class="gm-nearby-spinner"></div>
            <div>Đang tìm kiếm gần bạn...</div>
        </div>
    </div>

</div><!-- /gm-container -->

<!-- Time Slider: Lọc theo thời gian -->
<div class="gm-timeslider" id="gmTimeslider">
    <button class="gm-timeslider__btn" data-hrs="1">1h</button>
    <button class="gm-timeslider__btn" data-hrs="6">6h</button>
    <button class="gm-timeslider__btn active" data-hrs="24">24h</button>
    <button class="gm-timeslider__btn" data-hrs="168">7 ngày</button>
    <button class="gm-timeslider__btn" data-hrs="0">Tất cả</button>
    <span class="gm-timeslider__count" id="gmAlertCount"></span>
</div>

<!-- Nút báo cáo sự cố đã được chuyển vào sidebar -->

<!-- Nút Toggle Vệ tinh: nằm ngoài container, dùng position:fixed để không bị WebGL canvas đè -->
<button id="btnToggleSatellite" class="gm-layer-toggle" title="Bật/Tắt chế độ vệ tinh">
    <div class="gm-layer-toggle-inner">
        <div class="gm-layer-icon"></div>
        <span class="gm-layer-text" id="layerToggleText">Vệ tinh</span>
    </div>
</button>



@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@goongmaps/goong-js@1.0.9/dist/goong-js.js"></script>
    <script>
        window.APP_CONFIG = {
            goongMaptileKey : '@maptileKey',
            goongRestApiKey : '@restApiKey',
            isAuthenticated : @((User.Identity?.IsAuthenticated ?? false).ToString().ToLowerInvariant()),
            currentUserRole : '@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty)'
        };
    </script>
    <script src="~/js/map-core.js" asp-append-version="true"></script>
    <script src="~/js/map-nearby.js" asp-append-version="true"></script>
    <script src="~/js/map-routing.js" asp-append-version="true"></script>
    <script src="~/js/map-data.js" asp-append-version="true"></script>
    <script src="~/js/map-report.js" asp-append-version="true"></script>
}
