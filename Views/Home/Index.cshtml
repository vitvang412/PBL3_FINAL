@{
    ViewData["Title"] = "Trang chủ";
}

<div class="dsm-page">

    <!-- ══════════════ HERO ══════════════ -->
    <section class="hero">
        <div class="hero__bg"></div>
        <div class="hero__overlay"></div>
        <div class="hero__content">
            <div class="hero__badge">
                <span></span>
                HỆ THỐNG HOẠT ĐỘNG 24/7
            </div>
            <h1 class="hero__title">
                Bản đồ số cảnh báo<br>
                <em>an ninh Đà Nẵng</em>
            </h1>
            <p class="hero__sub">
                Theo dõi tình hình an ninh trật tự, tìm người thất lạc và cập nhật tin tức
                quan trọng tại thành phố Đà Nẵng theo thời gian thực.
            </p>
            <div class="hero__cta">
                <a asp-controller="Map" asp-action="Index" class="btn-hero-primary">
                    <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    Xem Bản đồ ngay
                </a>
                <a asp-controller="Article" asp-action="Index" class="btn-hero-secondary">
                    <svg viewBox="0 0 24 24"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
                    Tin tức an ninh
                </a>
            </div>
        </div>
    </section>

    <!-- ══════════════ FEATURE CARDS ══════════════ -->
    <section class="section fcard-section">
        <div class="section-header fcard-section__header">
            <div class="section-eyebrow">Hệ thống toàn diện</div>
            <h2 class="section-title">Tất cả công cụ bạn cần trong một nền tảng</h2>
            <p class="section-sub">Từ theo dõi bản đồ thời gian thực đến hỗ trợ tìm kiếm người thân — DaNang SafeMap luôn sẵn sàng bên bạn.</p>
        </div>

        <div class="feature-grid feature-grid--3">
            <!-- Card 1: Bản đồ -->
            <a asp-controller="Map" asp-action="Index" class="fcard2">
                <div class="fcard2__icon fcard2__icon--teal">
                    <svg viewBox="0 0 48 48" fill="none">
                        <circle cx="24" cy="22" r="14" fill="#b2dfdb"/>
                        <path d="M24 8C16.27 8 10 14.27 10 22c0 10.5 14 26 14 26s14-15.5 14-26c0-7.73-6.27-14-14-14z" fill="#00897B" opacity=".85"/>
                        <circle cx="24" cy="22" r="5" fill="#fff"/>
                    </svg>
                </div>
                <div class="fcard2__title">Bản đồ trực tuyến</div>
                <p class="fcard2__desc">Theo dõi các cảnh báo an ninh, tai nạn và sự kiện quan trọng trên bản đồ thời gian thực của toàn thành phố Đà Nẵng.</p>
                <span class="fcard2__btn">Xem thêm</span>
            </a>

            <!-- Card 2: Tin tức -->
            <a asp-controller="Article" asp-action="Index" class="fcard2">
                <div class="fcard2__icon fcard2__icon--blue">
                    <svg viewBox="0 0 48 48" fill="none">
                        <rect x="6" y="8" width="36" height="32" rx="4" fill="#bbdefb"/>
                        <rect x="12" y="16" width="24" height="3" rx="1.5" fill="#0288D1"/>
                        <rect x="12" y="22" width="18" height="3" rx="1.5" fill="#0288D1" opacity=".7"/>
                        <rect x="12" y="28" width="14" height="3" rx="1.5" fill="#0288D1" opacity=".5"/>
                    </svg>
                </div>
                <div class="fcard2__title">Tin tức an ninh</div>
                <p class="fcard2__desc">Cập nhật những tin tức mới nhất về tình hình an ninh trật tự, cảnh báo tội phạm và thông báo từ cơ quan chức năng.</p>
                <span class="fcard2__btn">Xem thêm</span>
            </a>

            <!-- Card 3: Tìm người -->
            <a asp-controller="MissingPerson" asp-action="Index" class="fcard2">
                <div class="fcard2__icon fcard2__icon--amber">
                    <svg viewBox="0 0 48 48" fill="none">
                        <circle cx="21" cy="20" r="12" fill="#ffe0b2"/>
                        <circle cx="21" cy="20" r="8" fill="none" stroke="#F57C00" stroke-width="3"/>
                        <line x1="30" y1="30" x2="40" y2="40" stroke="#E65100" stroke-width="3.5" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="fcard2__title">Tìm người thất lạc</div>
                <p class="fcard2__desc">Đăng tin tìm kiếm người thân, hỗ trợ cộng đồng tìm kiếm người già, trẻ em đi lạc hoặc mất tích tại Đà Nẵng.</p>
                <span class="fcard2__btn">Xem thêm</span>
            </a>
        </div>
    </section>

    <!-- ══════════════ FEATURE DETAIL: BẢN ĐỒ TRỰC TUYẾN ══════════════ -->
    <section class="feat-detail-section feat-detail-section--photo-1">
        <div class="feat-detail-inner">
            <!-- Cột trái: Header + nút -->
            <div class="feat-detail__text">
                <div class="section-eyebrow">Chức năng nổi bật</div>
                <h2 class="feat-detail__title">Bản đồ trực tuyến<br>thông minh &amp; trực quan</h2>
                <p class="feat-detail__desc">
                    Hệ thống hiển thị thông tin an ninh khu vực theo 3 mức zoom khác nhau, giúp người dân
                    chủ động nắm bắt tình hình và tránh các khu vực nguy hiểm trong thời gian thực.
                </p>
                <a asp-controller="Map" asp-action="Index" class="feat-detail__cta">
                    Xem Bản đồ ngay
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>

            <!-- Cột phải: 2 thẻ card xếp dọc -->
            <div class="feat-detail__items">
                <!-- Item 1: Heatmap -->
                <div class="feat-detail__item">
                    <div class="feat-detail__item-icon">
                        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                            <defs><linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4FC3F7"/><stop offset="100%" stop-color="#00897B"/></linearGradient></defs>
                            <rect x="6" y="8" width="52" height="40" rx="6" fill="url(#g1)" opacity=".2"/>
                            <rect x="10" y="12" width="44" height="32" rx="4" fill="url(#g1)"/>
                            <line x1="10" y1="24" x2="54" y2="24" stroke="#fff" stroke-width="1.5" opacity=".4"/>
                            <line x1="10" y1="34" x2="54" y2="34" stroke="#fff" stroke-width="1.5" opacity=".3"/>
                            <line x1="32" y1="12" x2="32" y2="44" stroke="#fff" stroke-width="1.5" opacity=".3"/>
                            <circle cx="38" cy="26" r="8" fill="#FF6B6B" opacity=".7"/>
                            <circle cx="24" cy="32" r="5" fill="#FFE66D" opacity=".6"/>
                            <path d="M38 18c-3 0-5.5 2.5-5.5 5.5S38 30 38 30s5.5-4 5.5-6.5S41 18 38 18z" fill="#FF6B6B"/>
                            <circle cx="38" cy="23.5" r="2" fill="#fff"/>
                        </svg>
                    </div>
                    <div>
                        <div class="feat-detail__item-title">Bản đồ nhiệt (Heatmap)</div>
                        <p class="feat-detail__item-desc">Hiển thị mật độ sự cố theo mã màu đỏ – cam – vàng – xanh, giúp nhận diện ngay vùng an toàn và vùng nhạy cảm trước khi di chuyển.</p>
                    </div>
                </div>
                <!-- Item 2: Báo cáo sự cố -->
                <div class="feat-detail__item">
                    <div class="feat-detail__item-icon feat-detail__item-icon--amber">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke="#F57C00"/>
                            <line x1="12" y1="9" x2="12" y2="13" stroke="#F57C00"/>
                            <line x1="12" y1="17" x2="12.01" y2="17" stroke="#F57C00"/>
                        </svg>
                    </div>
                    <div>
                        <div class="feat-detail__item-title">Báo cáo sự cố</div>
                        <p class="feat-detail__item-desc">Người dân có thể báo cáo sự cố an ninh trực tiếp trên bản đồ — thông tin được kiểm duyệt và cập nhật theo thời gian thực.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════ FEATURE DETAIL: TIN TỨC AN NINH ══════════════ -->
    <section class="feat-detail-section feat-detail-section--white-mid">
        <div class="feat-detail-inner">
            <!-- Cột trái: 2 thẻ card -->
            <div class="feat-detail__items">
                <div class="feat-detail__item">
                    <div class="feat-detail__item-icon">
                        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                            <defs><linearGradient id="g3" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4FC3F7"/><stop offset="100%" stop-color="#0288D1"/></linearGradient></defs>
                            <rect x="10" y="6" width="36" height="52" rx="4" fill="url(#g3)" opacity=".2"/>
                            <rect x="14" y="10" width="28" height="44" rx="3" fill="url(#g3)"/>
                            <rect x="20" y="20" width="16" height="3" rx="1.5" fill="#fff" opacity=".8"/>
                            <rect x="20" y="27" width="12" height="3" rx="1.5" fill="#fff" opacity=".6"/>
                            <rect x="20" y="34" width="14" height="3" rx="1.5" fill="#fff" opacity=".5"/>
                            <circle cx="48" cy="14" r="10" fill="#FF6B6B"/>
                            <text x="48" y="18" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">!</text>
                        </svg>
                    </div>
                    <div>
                        <div class="feat-detail__item-title">Tin tức thời gian thực</div>
                        <p class="feat-detail__item-desc">Cập nhật liên tục các bài viết về tình hình an ninh trật tự, cảnh báo từ cơ quan chức năng và thông báo khẩn cấp khu vực Đà Nẵng.</p>
                    </div>
                </div>
                <div class="feat-detail__item">
                    <div class="feat-detail__item-icon">
                        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                            <defs><linearGradient id="g4" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#FFD54F"/><stop offset="100%" stop-color="#FF9800"/></linearGradient></defs>
                            <path d="M32 4C22 4 14 10 14 18c0 8 6 14 6 14h24s6-6 6-14c0-8-8-14-18-14z" fill="url(#g4)" opacity=".2"/>
                            <path d="M32 10C25 10 19 15 19 21c0 6 5 11 5 11h16s5-5 5-11c0-6-6-11-13-11z" fill="url(#g4)"/>
                            <rect x="24" y="44" width="16" height="4" rx="2" fill="url(#g4)" opacity=".7"/>
                            <rect x="26" y="50" width="12" height="4" rx="2" fill="url(#g4)" opacity=".5"/>
                            <line x1="32" y1="18" x2="32" y2="28" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
                            <circle cx="38" cy="8" r="3" fill="#FF9800" opacity=".5"/>
                            <circle cx="26" cy="6" r="2" fill="#FFD54F" opacity=".6"/>
                        </svg>
                    </div>
                    <div>
                        <div class="feat-detail__item-title">Thông báo đẩy tức thì</div>
                        <p class="feat-detail__item-desc">Nhận thông báo ngay khi có sự cố xảy ra gần vị trí của bạn — không cần mở ứng dụng, vẫn luôn được cảnh báo kịp thời.</p>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Header + nút -->
            <div class="feat-detail__text">
                <div class="section-eyebrow">Luôn cập nhật</div>
                <h2 class="feat-detail__title">Tin tức an ninh<br>chính xác &amp; kịp thời</h2>
                <p class="feat-detail__desc">
                    Tổng hợp thông tin từ cơ quan chức năng, báo chí địa phương và cộng đồng người dân
                    — giúp bạn nắm bắt tình hình an ninh Đà Nẵng mọi lúc, mọi nơi.
                </p>
                <a asp-controller="Article" asp-action="Index" class="feat-detail__cta">
                    Xem tin tức
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ══════════════ FEATURE DETAIL: TÌM NGƯỜI THẤT LẠC ══════════════ -->
    <section class="feat-detail-section feat-detail-section--photo-2">
        <div class="feat-detail-inner">
            <!-- Cột trái: Header + nút -->
            <div class="feat-detail__text">
                <div class="section-eyebrow">Kết nối cộng đồng</div>
                <h2 class="feat-detail__title">Tìm người thất lạc<br>cùng sức mạnh cộng đồng</h2>
                <p class="feat-detail__desc">
                    Hệ thống cho phép đăng tin tìm kiếm, chia sẻ thông tin và liên lạc trực tiếp
                    với người đăng — giúp rút ngắn thời gian tìm kiếm người thân bị lạc tại Đà Nẵng.
                </p>
                <a asp-controller="MissingPerson" asp-action="Index" class="feat-detail__cta">
                    Tìm kiếm ngay
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>

            <!-- Cột phải: 2 thẻ card -->
            <div class="feat-detail__items">
                <div class="feat-detail__item">
                    <div class="feat-detail__item-icon">
                        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                            <defs><linearGradient id="g5" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#AB47BC"/><stop offset="100%" stop-color="#E040FB"/></linearGradient></defs>
                            <circle cx="28" cy="28" r="22" fill="url(#g5)" opacity=".15"/>
                            <circle cx="28" cy="28" r="14" fill="url(#g5)"/>
                            <circle cx="28" cy="28" r="6" fill="#fff" opacity=".3"/>
                            <line x1="38" y1="38" x2="54" y2="54" stroke="url(#g5)" stroke-width="6" stroke-linecap="round"/>
                            <circle cx="50" cy="12" r="5" fill="#E040FB" opacity=".4"/>
                        </svg>
                    </div>
                    <div>
                        <div class="feat-detail__item-title">Đăng tin tìm kiếm nhanh</div>
                        <p class="feat-detail__item-desc">Tạo bài đăng tìm người với ảnh, thông tin mô tả và vị trí mất tích chỉ trong vài bước — bài đăng được phân phối ngay tới cộng đồng khu vực.</p>
                    </div>
                </div>
                <div class="feat-detail__item">
                    <div class="feat-detail__item-icon">
                        <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                            <defs><linearGradient id="g6" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#26C6DA"/><stop offset="100%" stop-color="#00897B"/></linearGradient></defs>
                            <circle cx="32" cy="24" r="12" fill="url(#g6)"/>
                            <path d="M12 56c0-11 8-20 20-20s20 9 20 20" fill="url(#g6)" opacity=".3"/>
                            <circle cx="48" cy="20" r="8" fill="url(#g6)" opacity=".6"/>
                            <path d="M48 32c-4 0-8 4-8 8v4h16v-4c0-4-4-8-8-8z" fill="url(#g6)" opacity=".8"/>
                        </svg>
                    </div>
                    <div>
                        <div class="feat-detail__item-title">Cộng đồng cùng xác nhận</div>
                        <p class="feat-detail__item-desc">Người dân gần khu vực có thể xác nhận đã nhìn thấy hoặc cung cấp thêm thông tin — tăng tốc độ tìm kiếm nhờ sức mạnh tập thể.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- ══════════════ STATS SECTION ══════════════ -->
    <section class="stats-section">
        <div class="stats-section__top">
            <h2 class="stats-section__title">Cộng đồng an toàn hơn<br>mỗi ngày.</h2>
            <p class="stats-section__desc">DaNang SafeMap đang được hàng nghìn người dân Đà Nẵng tin dùng để theo dõi tình hình an ninh và hỗ trợ tìm kiếm người thân mỗi ngày.</p>
            <div class="stats-section__boxes">
                <div class="stats-section__box">
                    <div class="stats-section__box-num">12.000+</div>
                    <div class="stats-section__box-label">Người dùng đang hoạt động<br>với hàng chục nghìn lượt truy cập mỗi tháng</div>
                </div>
                <div class="stats-section__box">
                    <div class="stats-section__box-num">94 Đơn vị hành chính</div>
                    <div class="stats-section__box-label">được phủ sóng toàn diện bao gồm 23 phường,<br>70 xã và 01 đặc khu (Hoàng Sa)</div>
                </div>
            </div>
        </div>
        <div class="stats-section__bar">
            <div class="stats-section__bar-inner">
                <div class="stats-section__stat">
                    <div class="stats-section__stat-num">5K+</div>
                    <div class="stats-section__stat-label">Báo cáo đã xử lý</div>
                </div>
                <div class="stats-section__divider"></div>
                <div class="stats-section__stat">
                    <div class="stats-section__stat-num">30+</div>
                    <div class="stats-section__stat-label">Người thất lạc được tìm thấy</div>
                </div>
                <div class="stats-section__divider"></div>
                <div class="stats-section__stat">
                    <div class="stats-section__stat-num">12K+</div>
                    <div class="stats-section__stat-label">Người dùng tích cực</div>
                </div>
                <div class="stats-section__divider"></div>
                <div class="stats-section__stat">
                    <div class="stats-section__stat-num">24/7</div>
                    <div class="stats-section__stat-label">Hệ thống hoạt động liên tục</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════ HOW IT WORKS ══════════════ -->
    <section class="section steps-section">
        <div class="section-header">
            <div class="section-eyebrow">Cách hoạt động</div>
            <h2 class="section-title">Bắt đầu chỉ trong vài bước đơn giản</h2>
        </div>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-num">1</div>
                <h4>Đăng ký tài khoản</h4>
                <p>Tạo tài khoản miễn phí với email hoặc Google chỉ trong 30 giây.</p>
            </div>
            <div class="step-card">
                <div class="step-num">2</div>
                <h4>Theo dõi bản đồ</h4>
                <p>Xem các cảnh báo an ninh, sự cố và tin tức theo vị trí thực tế trên bản đồ.</p>
            </div>
            <div class="step-card">
                <div class="step-num">3</div>
                <h4>Báo cáo sự cố</h4>
                <p>Gửi báo cáo nhanh các tình huống bất thường để hỗ trợ cộng đồng kịp thời.</p>
            </div>
            <div class="step-card">
                <div class="step-num">4</div>
                <h4>Kết nối cộng đồng</h4>
                <p>Cùng người dân Đà Nẵng xây dựng thành phố an toàn và văn minh hơn.</p>
            </div>
        </div>
    </section>

    <!-- ══════════════ CTA ══════════════ -->
    <section class="cta-section">
        <div class="cta-overlay"></div>
        <div class="cta-inner">
            <h2>Sẵn sàng bảo vệ cộng đồng?</h2>
            <p>Tham gia cùng hàng nghìn người dân Đà Nẵng đang sử dụng DaNang SafeMap mỗi ngày.</p>
            <a asp-controller="Auth" asp-action="Register" class="btn-cta">
                <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                Đăng ký miễn phí ngay
            </a>
        </div>
    </section>

    <!-- ══════════════ FOOTER ══════════════ -->
    <footer class="dsm-footer">
        <div class="footer-main">
            <div class="footer-col">
                <div class="footer-brand">
