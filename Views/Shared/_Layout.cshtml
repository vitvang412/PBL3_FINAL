<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DaNang SafeMap</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    <style>
        .dsm-app-alert {
            position: fixed;
            inset: 0;
            z-index: 3000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(10, 21, 18, 0.38);
            backdrop-filter: blur(4px);
        }
        .dsm-app-alert.open {
            display: flex;
        }
        .dsm-app-alert__panel {
            width: min(460px, 100%);
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 22px;
            background: #ffffff;
            box-shadow: 0 24px 60px rgba(8, 24, 19, 0.2);
            overflow: hidden;
        }
        .dsm-app-alert__head {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 18px 20px 12px;
        }
        .dsm-app-alert__icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            color: #0f766e;
            background: #e6f8f4;
            flex-shrink: 0;
        }
        .dsm-app-alert__icon svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
        }
        .dsm-app-alert__title {
            color: #18312b;
            font-size: 18px;
            font-weight: 800;
            line-height: 1.2;
        }
        .dsm-app-alert__body {
            padding: 0 20px 20px;
            color: #5f746d;
            font-size: 15px;
            line-height: 1.7;
            white-space: pre-wrap;
        }
        .dsm-app-alert__foot {
            display: flex;
            justify-content: flex-end;
            padding: 0 20px 20px;
        }
        .dsm-app-alert__btn {
            min-width: 94px;
            min-height: 42px;
            border: 0;
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(135deg, #0d9488, #0f766e);
            font: inherit;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
        }
    </style>

    <!-- ══════════ NAVBAR ══════════ -->
    <nav class="dsm-nav">
        <div class="dsm-nav__inner">
            <!-- Brand -->
            <a class="dsm-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="dsm-brand__icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        <polyline points="9 12 11 14 15 10"/>
                    </svg>
                </div>
                <div class="dsm-brand__name">
                    DaNang SafeMap
                    <span>Hệ thống bản đồ an ninh</span>
                </div>
            </a>

            <!-- Nav links -->
            <ul class="dsm-nav__links">
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        Trang chủ
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Map" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        Bản đồ
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Article" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/></svg>
                        Tin tức
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="MissingPerson" asp-action="Index">
                        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        Tìm người
                    </a>
                </li>
            </ul>

            <!-- Right: Login button or User menu (rendered by JS) -->
            <div class="dsm-nav__right">
                <!-- Login button — hiện khi chưa đăng nhập -->
                <a href="/Auth/Login" class="nav-login-btn" id="navLoginBtn" style="display:none;">
                    Đăng Nhập
                </a>

                <!-- Bell notification — hiện khi đã đăng nhập -->
                <div class="dsm-bell" id="dsmBell" style="display:none;">
                    <button type="button" class="dsm-bell__btn" id="dsmBellBtn" aria-label="Thông báo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        <span class="dsm-bell__badge" id="dsmBellBadge" style="display:none;">0</span>
                    </button>
                    <div class="dsm-bell__dropdown" id="dsmBellDropdown">
                        <div class="dsm-bell__head">
                            <span>Thông báo</span>
                            <button type="button" class="dsm-bell__mark" id="dsmBellMarkAll">Đánh dấu đã đọc</button>
                        </div>
                        <div class="dsm-bell__list" id="dsmBellList">
                            <div class="dsm-bell__empty">Đang tải...</div>
                        </div>
                    </div>
                </div>

                <!-- User menu — hiện khi đã đăng nhập -->
                <div class="user-menu" id="userMenu" style="display:none;">
                    <button class="user-trigger" id="userTrigger" type="button" aria-label="Menu người dùng">
                        <div class="user-avatar" id="userAvatar">?</div>
                        <span class="user-name" id="userName">Người dùng</span>
                        <svg class="user-chevron" viewBox="0 0 24 24">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <div class="dropdown-header">
                            <div class="dh-name" id="dropdownName">Người dùng</div>
                            <div class="dh-email" id="dropdownEmail">-</div>
                        </div>
                        <a href="/User/Dashboard" class="dropdown-item">
                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            Dashboard của tôi
                        </a>
                        <a href="/Auth/Profile" class="dropdown-item">
                            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            Trang cá nhân
                        </a>
                        <div class="dropdown-divider"></div>
                        <button class="dropdown-item danger" id="logoutBtn" type="button">
                            <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            Đăng xuất
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- ══════════ MAIN CONTENT ══════════ -->
    <div class="page-content">
        @RenderBody()
    </div>

    <div class="dsm-app-alert" id="dsmAppAlert" aria-hidden="true">
        <div class="dsm-app-alert__panel" role="alertdialog" aria-modal="true" aria-labelledby="dsmAppAlertTitle" aria-describedby="dsmAppAlertBody">
            <div class="dsm-app-alert__head">
                <div class="dsm-app-alert__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                </div>
                <div class="dsm-app-alert__title" id="dsmAppAlertTitle">Thông báo</div>
            </div>
            <div class="dsm-app-alert__body" id="dsmAppAlertBody"></div>
            <div class="dsm-app-alert__foot">
                <button type="button" class="dsm-app-alert__btn" id="dsmAppAlertOk">Đã hiểu</button>
            </div>
        </div>
    </div>

    <script>
    // ── App alert dialog ──────────────────────────────────────────────────
    (function () {
        var overlay = document.getElementById('dsmAppAlert');
        var body = document.getElementById('dsmAppAlertBody');
        var okBtn = document.getElementById('dsmAppAlertOk');
        if (!overlay || !body || !okBtn) return;

        var previousAlert = window.alert ? window.alert.bind(window) : null;
        var onClose = null;

        function closeAlert() {
            overlay.classList.remove('open');
            overlay.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            if (typeof onClose === 'function') {
                var cb = onClose;
                onClose = null;
                cb();
            }
        }

        window.showAppAlert = function (message, callback) {
            body.textContent = message || '';
            onClose = typeof callback === 'function' ? callback : null;
            overlay.classList.add('open');
            overlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            setTimeout(function () { okBtn.focus(); }, 0);
        };

        window.alert = function (message) {
            if (window.showAppAlert) {
                window.showAppAlert(message);
                return;
            }
            if (previousAlert) previousAlert(message);
        };

        okBtn.addEventListener('click', closeAlert);
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeAlert();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && overlay.classList.contains('open')) closeAlert();
        });
    })();

    // ── Auth state from localStorage ──────────────────────────────────────
    (function () {
        try {
            var raw  = localStorage.getItem('user');
            var user = raw ? JSON.parse(raw) : null;

            if (user && (user.fullName || user.email)) {
                // Đã đăng nhập
                var name   = user.fullName || user.email.split('@@')[0];
                var email  = user.email || '';
                var initials = name.charAt(0).toUpperCase();

                document.getElementById('userAvatar').textContent   = initials;
                document.getElementById('userName').textContent     = name;
                document.getElementById('dropdownName').textContent  = name;
                document.getElementById('dropdownEmail').textContent = email;

                document.getElementById('navLoginBtn').style.display = 'none';
                document.getElementById('userMenu').style.display    = 'flex';
                var bellEl = document.getElementById('dsmBell');
                if (bellEl) { bellEl.style.display = 'inline-flex'; if (window.__dsmBellInit) window.__dsmBellInit(); }

                // Admin chỉ còn link Admin Dashboard; user thường không còn "Quản lý bài viết" ở đây.
                if (user.role === 'Admin' || user.Role === 'Admin') {
                    var divider = document.querySelector('.dropdown-divider');
                    if (divider) {
                        var adminLink = document.createElement('a');
                        adminLink.className = 'dropdown-item';
                        adminLink.href = '/Admin/AlertModeration';
                        adminLink.style.color = 'var(--dsm-primary, #2D6A4F)';
                        adminLink.innerHTML = '<svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg> <strong>Trang Quản Trị</strong>';
                        divider.parentNode.insertBefore(adminLink, divider);
                    }
                }
            } else {
                // Chưa đăng nhập
                document.getElementById('navLoginBtn').style.display = 'flex';
                document.getElementById('userMenu').style.display    = 'none';
            }
        } catch (e) {
            document.getElementById('navLoginBtn').style.display = 'flex';
        }
    })();

    // ── Toggle dropdown ───────────────────────────────────────────────────
    var trigger  = document.getElementById('userTrigger');
    var menu     = document.getElementById('userMenu');
    if (trigger) {
        trigger.addEventListener('click', function (e) {
            e.stopPropagation();
            menu.classList.toggle('open');
        });
        document.addEventListener('click', function () {
            menu.classList.remove('open');
        });
    }

    // ── Bell notification ─────────────────────────────────────────────────
    (function(){
        var btn      = document.getElementById('dsmBellBtn');
        var dropdown = document.getElementById('dsmBellDropdown');
        var badge    = document.getElementById('dsmBellBadge');
        var list     = document.getElementById('dsmBellList');
        var markAll  = document.getElementById('dsmBellMarkAll');
        if (!btn || !dropdown) return;
        function authHeaders() {
            var token = localStorage.getItem('token');
            return token ? { 'Authorization': 'Bearer ' + token } : {};
        }

        function fmt(n){ if (n == null) return ''; return n.createdAt || ''; }
        function renderItems(items){
            if (!items || !items.length){
                list.innerHTML = '<div class="dsm-bell__empty">' +
                    '<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#d1d5db" stroke-width="1.5" style="margin-bottom:8px"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>' +
                    '<p style="margin:0;color:#9ca3af;font-size:13px;">Chưa có thông báo nào</p></div>';
                return;
            }
            function getIcon(title) {
                if (!title) return { svg: notiBellSvg(), bg: '#e0f2fe', color: '#0284c7' };
                var t = title.toLowerCase();
                if (t.includes('duy\u1ec7t') || t.includes('xu\u1ea5t b\u1ea3n') || t.includes('approved'))
                    return { svg: notiCheckSvg(), bg: '#dcfce7', color: '#16a34a' };
                if (t.includes('t\u1eeb ch\u1ed1i') || t.includes('rejected') || t.includes('\u2716'))
                    return { svg: notiXSvg(), bg: '#fee2e2', color: '#dc2626' };
                if (t.includes('ch\u1edd') || t.includes('pending') || t.includes('xem x\u00e9t'))
                    return { svg: notiClockSvg(), bg: '#fef9c3', color: '#ca8a04' };
                return { svg: notiBellSvg(), bg: '#e0f2fe', color: '#0284c7' };
            }
            function notiCheckSvg() { return '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'; }
            function notiXSvg()     { return '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'; }
            function notiClockSvg() { return '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>'; }
            function notiBellSvg()  { return '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>'; }
            function fmtTime(s) {
                if (!s) return '';
                try {
                    var d = new Date(s), now = new Date(), diff = Math.floor((now - d) / 1000);
                    if (diff < 60) return 'Vừa xong';
                    if (diff < 3600) return Math.floor(diff/60) + ' phút trước';
                    if (diff < 86400) return Math.floor(diff/3600) + ' giờ trước';
                    return d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
                } catch(e) { return s; }
            }
            list.innerHTML = items.map(function(n){
                var href = n.link || (n.articleId ? ('/Article/Details/' + n.articleId) : '#');
                var cls  = 'dsm-noti-item' + (n.isRead ? '' : ' unread');
                var ico  = getIcon(n.title);
                var title = (n.title || 'Thông báo').replace(/[\u2705\u274c\u274e\u26a0\ufe0f\u2714\u2716]/g, '').trim();
                var msg   = (n.message || n.content || '').replace(/[\u2705\u274c\u274e\u26a0\ufe0f\u2714\u2716]/g, '').trim();
                return '<a class="' + cls + '" href="' + href + '" data-id="' + n.id + '" style="text-decoration:none;color:inherit">' +
                    '<div class="dsm-noti-item__icon" style="background:' + ico.bg + ';color:' + ico.color + '">' + ico.svg + '</div>' +
                    '<div class="dsm-noti-item__content">' +
                        '<div class="dsm-noti-item__title">' + title + '</div>' +
                        (msg ? '<div class="dsm-noti-item__desc">' + msg + '</div>' : '') +
                        '<div class="dsm-noti-item__time">' + fmtTime(n.createdAt) + '</div>' +
                    '</div>' +
                    (!n.isRead ? '<div style="width:7px;height:7px;border-radius:50%;background:#2D6A4F;flex-shrink:0;margin-top:4px;"></div>' : '') +
                '</a>';
            }).join('');
            // Chấm nhỏ đã đọc khi click từng thông báo
            Array.prototype.forEach.call(list.querySelectorAll('.dsm-noti-item'), function(a){
                a.addEventListener('click', function(){
                    var id = a.getAttribute('data-id');
                    if (id) fetch('/api/notification/read/' + id, { method: 'POST', headers: authHeaders() });
                });
            });
        }
        function refresh(){
            fetch('/api/notification/unread', { headers: authHeaders() }).then(function(r){
                if (!r.ok) throw new Error('unauthorized');
                return r.json();
            }).then(function(data){
                var n = (data && data.length) || 0;
                if (n > 0){ badge.textContent = n > 99 ? '99+' : n; badge.style.display = 'flex'; }
                else { badge.style.display = 'none'; }
                
                // Đồng thời gọi /recent để render dropdown list
                fetch('/api/notification/recent', { headers: authHeaders() })
                    .then(function(r){ if (!r.ok) throw new Error('recent failed'); return r.json(); })
                    .then(d => renderItems(d))
                    .catch(() => { list.innerHTML = '<div class="dsm-bell__empty">Không tải được thông báo.</div>'; });
            }).catch(function(){ list.innerHTML = '<div class="dsm-bell__empty">Không tải được thông báo.</div>'; });
        }
        window.__dsmBellInit = refresh;
        // Auto-refresh ngay khi load (không cần đợi bấm nút) để hiện badge số chưa đọc.
        try {
            var raw = localStorage.getItem('user');
            var u = raw ? JSON.parse(raw) : null;
            if (u && (u.fullName || u.email)) refresh();
        } catch (e) { /* ignore */ }
        // Poll mỗi 60s để badge cập nhật realtime.
        setInterval(function(){
            try {
                var raw = localStorage.getItem('user');
                var u = raw ? JSON.parse(raw) : null;
                if (u && (u.fullName || u.email)) refresh();
            } catch (e) { /* ignore */ }
        }, 60000);
        btn.addEventListener('click', function(e){
            e.stopPropagation();
            dropdown.classList.toggle('open');
            if (dropdown.classList.contains('open')) {
                refresh();
                // Tự đánh dấu đã đọc sau 1.5s
                setTimeout(function() {
                    fetch('/api/notification/readAll', { method: 'POST', headers: authHeaders() }).then(function() {
                        badge.style.display = 'none';
                        // Reload items để bỏ dot xanh
                        refresh();
                    });
                }, 1500);
            }
        });
        document.addEventListener('click', function(){ dropdown.classList.remove('open'); });
        dropdown.addEventListener('click', function(e){ e.stopPropagation(); });
        if (markAll){
            markAll.addEventListener('click', function(){
                fetch('/api/notification/readAll', { method: 'POST', headers: authHeaders() }).then(refresh);
            });
        }
    })();

    // ── Logout ────────────────────────────────────────────────────────────
    var logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', function () {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = '/Auth/Login';
        });
    }
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
